# StratDesk Pro — Environment Variables Template
# Copy this file to .env.local for local custom configuration.
# None of these are required; sensible defaults are baked in.

# Public site URL (used for OpenGraph tags & sitemaps)
# On Vercel, VERCEL_URL is used automatically if this is omitted.
NEXT_PUBLIC_SITE_URL=https://stratdesk.internal

# Master secret key for local HMAC-SHA256 command bus signing
# Defaults to "stratdesk_local_master_secret_v1" if omitted.
STRATDESK_SECRET=stratdesk_local_master_secret_v1
